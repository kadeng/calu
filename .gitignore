# Secrets
.env
.env.*
!.env.template

# Python build artifacts
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.venv/
dist/

# Coverage, when it is measured ad hoc (docs/TESTING.md); never part of the repository.
.coverage
.coverage.*
htmlcov/

# VSCode extension build output
extensions/vscode/node_modules/
extensions/vscode/dist/
extensions/vscode/out/
extensions/vscode/.vscode-test/
*.vsix
.claude/worktrees/

# Session traces (agent/traces/<date>/<user>/session_NNN.md, D232) and temporary trace files
agent/traces/**/session_*.md
agent/traces/**/*.tmp.md
