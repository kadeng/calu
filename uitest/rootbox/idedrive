#!/bin/bash
# idedrive [unlock-password]: feed a few requests to `calu ide` in the current directory and print the answers, cut.
CALU=${CALU:-calu}
{
  echo '{"jsonrpc":"2.0","id":1,"method":"ide.initialize","params":{"client":"rootbox"}}'; sleep 3
  echo '{"jsonrpc":"2.0","id":2,"method":"ide.status","params":{}}'; sleep 2
  if [ -n "${1-}" ]; then printf '{"jsonrpc":"2.0","id":3,"method":"ide.unlock","params":{"password":"%s"}}\n' "$1"; sleep 3; fi
  echo '{"jsonrpc":"2.0","id":4,"method":"ide.sessions","params":{}}'; sleep 3
  echo '{"jsonrpc":"2.0","id":5,"method":"ide.attach","params":{}}'; sleep 4
  echo '{"jsonrpc":"2.0","id":6,"method":"session.call","params":{"method":"state.get","params":{}}}'; sleep 2
  echo '{"jsonrpc":"2.0","id":7,"method":"ide.settings.get","params":{}}'; sleep 2
  echo '{"jsonrpc":"2.0","id":8,"method":"ide.shutdown","params":{}}'; sleep 1
} | $CALU ide 2>&1 | grep -v '"method"' | cut -c1-${CUT:-330}
