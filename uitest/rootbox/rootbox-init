#!/bin/bash
# PID 1 of the root box: starts PostgreSQL (no systemd here) and waits.
#
# Two clusters listen on 127.0.0.1: port 5432 for root's calu, port 5433 for a user's own
# setup. On the first start each gets the role and the databases the guide's "existing
# server" variant asks an administrator for:
#   CREATE ROLE calu_owner LOGIN CREATEROLE PASSWORD 'owner-pw';
#   CREATE DATABASE calu OWNER calu_owner;
# and a second database `calu_old` of the same owner, for the migration case of the test plan.
set -u
for cluster in $(pg_lsclusters -h | awk '{print $2}'); do
    pg_ctlcluster 16 "$cluster" start
done
for port in 5432 5433; do
    for _ in $(seq 1 60); do
        pg_isready -q -h 127.0.0.1 -p "$port" && break
        sleep 0.5
    done
    if ! su postgres -c "psql -p $port -Atc \"SELECT 1 FROM pg_roles WHERE rolname = 'calu_owner'\"" | grep -q 1; then
        su postgres -c "psql -q -p $port" <<'SQL'
CREATE ROLE calu_owner LOGIN CREATEROLE PASSWORD 'owner-pw';
CREATE DATABASE calu OWNER calu_owner;
CREATE DATABASE calu_old OWNER calu_owner;
SQL
    fi
done
# `docker stop`: end the clusters at once (clients may still be connected), then leave.
stop_all() {
    for cluster in $(pg_lsclusters -h | awk '{print $2}'); do
        pg_ctlcluster 16 "$cluster" stop -m fast >/dev/null 2>&1
    done
    exit 0
}
trap stop_all TERM INT
while :; do sleep 3600 & wait $!; done
