<idea-plugin>
    <dependencies>
        <module name="intellij.platform.frontend"/>
        <module name="calu.shared"/>
        <plugin id="org.jetbrains.plugins.terminal"/>
        <module name="intellij.terminal.frontend"/>
    </dependencies>

    <extensions defaultExtensionNs="com.intellij">
        <toolWindow id="calu" anchor="right" secondary="false"
                    factoryClass="io.github.kadeng.calu.frontend.CaluToolWindowFactory"
                    icon="io.github.kadeng.calu.frontend.CaluIcons.ToolWindow"/>
        <postStartupActivity implementation="io.github.kadeng.calu.frontend.CaluStartup"/>
        <notificationGroup id="calu" displayType="STICKY_BALLOON"/>
        <statusBarWidgetFactory id="calu.decisions" implementation="io.github.kadeng.calu.frontend.CaluStatusBarWidgetFactory"/>
        <projectConfigurable parentId="tools" id="calu" displayName="calu"
                             instance="io.github.kadeng.calu.frontend.CaluConfigurable"/>
    </extensions>

    <actions>
        <action id="calu.AddComment" class="io.github.kadeng.calu.frontend.CommentAction"
                text="Add Comment for Claude" description="Send a comment on the selected lines to the attached calu session">
            <add-to-group group-id="EditorPopupMenu" anchor="last"/>
            <add-to-group group-id="Diff.EditorPopupMenu" anchor="last"/>
            <keyboard-shortcut keymap="$default" first-keystroke="control alt K"/>
        </action>
    </actions>
</idea-plugin>
