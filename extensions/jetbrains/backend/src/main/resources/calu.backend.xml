<idea-plugin>
    <dependencies>
        <module name="intellij.platform.backend"/>
        <module name="intellij.platform.kernel.backend"/>
        <module name="calu.shared"/>
    </dependencies>

    <extensionPoints>
        <!-- PyCharm's SSH interpreter for the SSH mode; implemented by the optional module calu.python. -->
        <extensionPoint qualifiedName="io.github.kadeng.calu.sshInterpreterSetup"
                        interface="io.github.kadeng.calu.backend.SshInterpreterSetup" dynamic="true"/>
    </extensionPoints>

    <extensions defaultExtensionNs="com.intellij">
        <platform.rpc.backend.remoteApiProvider implementation="io.github.kadeng.calu.backend.BackendRpcApiProvider"/>
        <editorNotificationProvider implementation="io.github.kadeng.calu.backend.CheckerBannerProvider"/>
        <pathMacroFilter implementation="io.github.kadeng.calu.backend.CaluPathMacroFilter"/>
        <fileDocumentManagerListener implementation="io.github.kadeng.calu.backend.CheckerSaveListener"/>
        <projectViewNodeDecorator implementation="io.github.kadeng.calu.backend.SyncProjectViewDecorator"/>
        <!-- Asks before a run or debug start while local saves are held (SSH mode); see HeldFilesRunner. -->
        <programRunner id="caluHeldFiles" order="first" implementation="io.github.kadeng.calu.backend.HeldFilesRunner"/>
    </extensions>

    <projectListeners>
        <!-- A start that bypassed HeldFilesRunner (Rerun) while files are held: a notification. -->
        <listener class="io.github.kadeng.calu.backend.HeldFilesStartListener" topic="com.intellij.execution.ExecutionListener"/>
    </projectListeners>
</idea-plugin>
